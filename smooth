local function UpdateVisuals()

	if AimAssistEnabled then

		ToggleButton.BackgroundColor3 =
			Color3.fromRGB(50, 170, 80)

	else

		ToggleButton.BackgroundColor3 =
			Color3.fromRGB(180, 50, 50)

