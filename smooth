ToggleButton.Parent = Gui
ToggleButton.Size = UDim2.new(0, 60, 0, 60)
ToggleButton.Position = UDim2.new(1, -75, 0.5, -30)
ToggleButton.Text = "🎯"
ToggleButton.TextScaled = true
ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
ToggleButton.TextColor3 = Color3.new(1, 1, 1)
ToggleButton.BorderSizePixel = 0

local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(1, 0)
ButtonCorner.Parent = ToggleButton

--------------------------------------------------------
-- POPUP
--------------------------------------------------------

local PopupLabel = Instance.new("TextLabel")
PopupLabel.Name = "PopupLabel"
PopupLabel.Parent = Gui
PopupLabel.Size = UDim2.new(0, 220, 0, 45)
PopupLabel.Position = UDim2.new(0.5, -110, 0.1, 0)
PopupLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
PopupLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
PopupLabel.TextSize = 16
PopupLabel.Font = Enum.Font.GothamBold
PopupLabel.Text = "Press E to aim"
PopupLabel.Visible = false
PopupLabel.BackgroundTransparency = 0.2

local PopupCorner = Instance.new("UICorner")
PopupCorner.CornerRadius = UDim.new(0, 8)
PopupCorner.Parent = PopupLabel

--------------------------------------------------------
-- DEVICE DETECTION
--------------------------------------------------------

local IsPC = UserInputService.KeyboardEnabled
	and not UserInputService.TouchEnabled

if IsPC then
	ToggleButton.Visible = false

	PopupLabel.Visible = true
	PopupLabel.TextTransparency = 1
	PopupLabel.BackgroundTransparency = 1

	local fadeIn = TweenService:Create(
		PopupLabel,
		TweenInfo.new(0.5),
		{
			TextTransparency = 0,
			BackgroundTransparency = 0.2
		}
	)

	fadeIn:Play()

	task.delay(3, function()
		local fadeOut = TweenService:Create(
			PopupLabel,
			TweenInfo.new(0.5),
			{
				TextTransparency = 1,
				BackgroundTransparency = 1
			}
		)

		fadeOut:Play()

		fadeOut.Completed:Connect(function()
			PopupLabel.Visible = false
		end)
	end)
end

--------------------------------------------------------
-- MOBILE DRAGGING
--------------------------------------------------------

local function MakeDraggable(Object)

	local Dragging = false
	local DragInput
	local DragStart
	local StartPosition

	Object.InputBegan:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			DragStart = Input.Position

			StartPosition = UDim2.new(
				0,
				Object.AbsolutePosition.X,
				0,
				Object.AbsolutePosition.Y
			)

			Input.Changed:Connect(function()

				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end

			end)
		end
	end)

	Object.InputChanged:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then

			DragInput = Input
		end

	end)

	UserInputService.InputChanged:Connect(function(Input)

		if Input == DragInput and Dragging then

			local Delta = Input.Position - DragStart

			Object.Position = UDim2.new(
				0,
				StartPosition.X.Offset + Delta.X,
				0,
				StartPosition.Y.Offset + Delta.Y
			)

		end

	end)
end

if not IsPC then
	MakeDraggable(ToggleButton)
end

--------------------------------------------------------
-- CLAMP BUTTON
--------------------------------------------------------

local function Clamp(Object)

	if not Object.Visible then
		return
	end

	local Viewport = Camera.ViewportSize

	if Viewport.X == 0 or Viewport.Y == 0 then
		return
	end

	local currentX = Object.AbsolutePosition.X
	local currentY = Object.AbsolutePosition.Y

	local clampedX = math.clamp(
		currentX,
		0,
		Viewport.X - Object.AbsoluteSize.X
	)

	local clampedY = math.clamp(
		currentY,
		0,
		Viewport.Y - Object.AbsoluteSize.Y
	)

	if currentX ~= clampedX or currentY ~= clampedY then

		Object.Position = UDim2.new(
			0,
			clampedX,
			0,
			clampedY
		)

	end
end

