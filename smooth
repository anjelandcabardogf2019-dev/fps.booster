--------------------------------------------------------
-- CROSSHAIR TARGETING
--------------------------------------------------------

local function GetPlayerNearCrosshair()

	local ViewportSize = Camera.ViewportSize

	-- Center of the screen
	local ScreenCenter = Vector2.new(
		ViewportSize.X / 2,
		ViewportSize.Y / 2
	)

	local ClosestPlayer = nil
	local ClosestPart = nil
	local ClosestRoot = nil

	-- Start with maximum FOV distance
	local ClosestScreenDistance = AimFOV

	for _, Player in ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer
			and Player.Character then

			local Character = Player.Character

			local Humanoid =
				Character:FindFirstChildOfClass("Humanoid")

			local Head =
				Character:FindFirstChild("Head")

			local Root =
				Character:FindFirstChild("HumanoidRootPart")

			if Humanoid
				and Head
				and Root
				and Humanoid.Health > 0 then

				------------------------------------------------
				-- Convert the player's head position into
				-- 2D screen coordinates
				------------------------------------------------

				local ScreenPosition, OnScreen =
					Camera:WorldToViewportPoint(Head.Position)

				if OnScreen and ScreenPosition.Z > 0 then

					local PlayerScreenPosition =
						Vector2.new(
							ScreenPosition.X,
							ScreenPosition.Y
						)

					------------------------------------------------
					-- Distance from crosshair
					------------------------------------------------

					local ScreenDistance =
						(PlayerScreenPosition - ScreenCenter).Magnitude

					------------------------------------------------
					-- Closest player to crosshair wins
					------------------------------------------------

					if ScreenDistance < ClosestScreenDistance then

						ClosestScreenDistance = ScreenDistance

						ClosestPlayer = Player
						ClosestPart = AimAtHead
							and Head
							or Root

						ClosestRoot = Root

					end
				end
			end
		end
	end

	return ClosestPlayer, ClosestPart, ClosestRoot
end

--------------------------------------------------------
-- CORE AIM LOOP
--------------------------------------------------------

RunService.RenderStepped:Connect(function()

	Clamp(ToggleButton)

	if not AimAssistEnabled then
		return
	end

	local MyCharacter = LocalPlayer.Character

	if not MyCharacter then
		return
	end

	local MyRoot =
		MyCharacter:FindFirstChild("HumanoidRootPart")

	if not MyRoot then
		return
	end

	----------------------------------------------------
	-- GET PLAYER CLOSEST TO CROSSHAIR
	----------------------------------------------------

	local Player, AimPart, EnemyRoot =
		GetPlayerNearCrosshair()

	if Player and AimPart and EnemyRoot then

		Camera.CameraType = Enum.CameraType.Custom

		------------------------------------------------
		-- CAMERA AIM
		------------------------------------------------

		local TargetLook =
			CFrame.lookAt(
				Camera.CFrame.Position,
				AimPart.Position
			)

		local TargetRotation =
			TargetLook - TargetLook.Position

		Camera.CFrame =
			CFrame.new(Camera.CFrame.Position)
			* TargetRotation

		------------------------------------------------
		-- ROTATE PLAYER TOWARD TARGET
		------------------------------------------------

		local FlatEnemyPos = Vector3.new(
			EnemyRoot.Position.X,
			MyRoot.Position.Y,
			EnemyRoot.Position.Z
		)

		if (FlatEnemyPos - MyRoot.Position).Magnitude > 0.1 then

			MyRoot.CFrame =
				CFrame.lookAt(
					MyRoot.Position,
					FlatEnemyPos
				)

		end
	end
end)
```

This changes the targeting behavior from **3D distance** to **2D distance from the crosshair**.

### How it works

Imagine your screen is:

```text
             Enemy
               X
               
       Enemy
         X

              +
           CROSSHAIR

                    Enemy
                      X
```

The script converts every player's `Head.Position` into a screen position using:

```lua
Camera:WorldToViewportPoint(Head.Position)
```

Then it calculates:

```lua
ScreenDistance =
    (PlayerScreenPosition - ScreenCenter).Magnitude
```

The player with the **smallest screen distance** is selected.

### Adjust the aim-assist radius

This line controls how far away from the crosshair a player can be:

```lua
local AimFOV = 250
```

For example:

```lua
local AimFOV = 100
```

= very small aim area.

```lua
local AimFOV = 250
```

= moderate aim area.

```lua
local AimFOV = 500
```

= large aim area.
